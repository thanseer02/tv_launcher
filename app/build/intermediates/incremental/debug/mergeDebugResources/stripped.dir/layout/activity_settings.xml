<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_screen_padding_horizontal"
    android:paddingTop="@dimen/tv_screen_padding_vertical"
    android:paddingEnd="@dimen/tv_screen_padding_horizontal"
    android:paddingBottom="@dimen/tv_screen_padding_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Setting 1: Grid Columns -->
            <include
                android:id="@+id/setting_grid_columns"
                layout="@layout/item_tv_setting" />

            <!-- Setting 2: Themes -->
            <include
                android:id="@+id/setting_theme"
                layout="@layout/item_tv_setting" />

            <!-- Setting 3: Sort Order -->
            <include
                android:id="@+id/setting_sort_order"
                layout="@layout/item_tv_setting" />

            <!-- Setting 4: Unhide Apps -->
            <include
                android:id="@+id/setting_hidden_apps"
                layout="@layout/item_tv_setting" />

            <!-- Setting 5: Set Default Home -->
            <include
                android:id="@+id/setting_default_home"
                layout="@layout/item_tv_setting" />

            <!-- Setting 6: About -->
            <include
                android:id="@+id/setting_about"
                layout="@layout/item_tv_setting" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

