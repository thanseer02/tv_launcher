<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_card_corner_radius" />
            <solid android:color="@color/surface_card_focused" />
            <stroke android:width="@dimen/tv_focus_stroke_width" android:color="@color/focus_border_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_card_corner_radius" />
            <solid android:color="@color/surface_card" />
            <stroke android:width="1dp" android:color="#2A2A2A" />
        </shape>
    </item>
</selector>

